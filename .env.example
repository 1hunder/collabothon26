# Postgres DSN (normalised to postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://fq:fq@localhost:5432/financequest
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
# Gemini TTS voices (defaults below; GET /v1beta/voices lists the catalogue)
# TTS_VOICE_DM=en-gb-storyteller-4
# TTS_VOICE_BUDDY=Sulafat
MODEL_ID=claude-opus-5-5
GUESSERS_PER_ATTEMPT=3
WEB_SEARCH_MAX_USES=12
MAX_ATTEMPTS=3
CHECK_CONCURRENCY=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CACHE_DIR=.cache/prices
DATA_DIR=data
# Durable storage (quest documents, art, TTS cache). Empty STORAGE_BUCKET = local files in DATA_DIR.
# Set all of these to use an S3-compatible bucket (Railway Bucket in production).
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
DEMO_MODE=false
# Personal quests: with DEMO_MODE=true the daily quest is this pre-created scenario (from
# `python -m financequest quest generate`); empty = the newest generated quest, else the sample pack.
DEMO_SCENARIO_ID=
# Company generations running at the same time (each is a separate agent run)
GENERATION_CONCURRENCY=2
FAKE_LLM=false
CORS_ORIGINS=http://localhost:5173,https://*.vercel.app
LOG_LEVEL=INFO
# Thresholds (recorded into each check run)
START_WINDOW_MONTHS=3
START_CONFIDENCE_PCT=30
MIN_READABILITY=3
JITTER_PCT=30
DISPLAY_CAP=10000
# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_MODE=live
# Deploy (see docs/deploy.md). Railway injects PORT; the Postgres plugin provides DATABASE_URL.
# CI secrets (GitHub): RAILWAY_TOKEN, VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# CI variable (GitHub, optional): RAILWAY_SERVICE (default "api")
PORT=8000
